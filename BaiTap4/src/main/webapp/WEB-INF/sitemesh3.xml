<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!-- Mặc định: tất cả các trang đều dùng decorator main-layout -->
    <mapping path="/*" decorator="/WEB-INF/decorators/main-layout.jsp"/>

    <!-- Không apply decorator cho các trang auth -->
    <mapping path="/login" exclude="true"/>
    <mapping path="/register" exclude="true"/>
    <mapping path="/forgot-password" exclude="true"/>
    <mapping path="/reset-password" exclude="true"/>
    <mapping path="/verify-otp" exclude="true"/>

    <!-- Không apply decorator cho các trang admin -->
    <mapping path="/admin/*" exclude="true"/>

    <!-- Không apply decorator cho image servlet -->
    <mapping path="/image" exclude="true"/>

    <!-- Không apply decorator cho static resources -->
    <mapping path="/views/decorator/*" exclude="true"/>
    <mapping path="/views/style.css" exclude="true"/>
    <mapping path="/views/error.jsp" exclude="true"/>
</sitemesh>