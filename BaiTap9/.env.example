# =============================== 
# DATABASE CONFIGURATION
# =============================== 
DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=webst9;encrypt=false;trustServerCertificate=true;sslProtocol=TLSv1.2;characterEncoding=UTF-8
DB_USERNAME=sa
DB_PASSWORD=your_database_password

# =============================== 
# JPA / HIBERNATE
# =============================== 
DDL_AUTO=update
SHOW_SQL=false

# =============================== 
# SERVER CONFIGURATION
# =============================== 
SERVER_PORT=8081

# =============================== 
# DATA SEEDING & SECURITY
# =============================== 
APP_SEED_ENABLED=true
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your_strong_admin_password
USER_PASSWORD=your_user_password
