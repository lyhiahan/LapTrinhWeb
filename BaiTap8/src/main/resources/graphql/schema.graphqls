type Category {
    id: ID!
    name: String!
    products: [Product]
}

type Product {
    id: ID!
    title: String!
    price: Float!
    description: String
    category: Category
}

type Query {
    # 1. Hiển thị tất cả product có price từ thấp đến cao
    productsByPriceAsc: [Product]
    
    # 2. Lấy tất cả product của 01 category
    productsByCategory(categoryId: ID!): [Product]
    
    # CRUD queries
    allProducts: [Product]
    productById(id: ID!): Product
    allCategories: [Category]
    categoryById(id: ID!): Category
}

type Mutation {
    # CRUD Category
    createCategory(name: String!): Category
    updateCategory(id: ID!, name: String!): Category
    deleteCategory(id: ID!): Boolean

    # CRUD Product
    createProduct(title: String!, price: Float!, description: String, categoryId: ID!): Product
    updateProduct(id: ID!, title: String!, price: Float!, description: String, categoryId: ID!): Product
    deleteProduct(id: ID!): Boolean
}
